# Copy to .env.local — never commit .env.local

# --- Firebase (client — leaderboard read/write from server actions) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only — webhooks, Vercel) ---
# Firebase Console → Project settings → Service accounts → Generate new private key
# Use separate vars (recommended on Vercel). Private key: one line with literal \n between lines.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Alternative: single minified JSON (local dev only)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- Buy Me a Coffee ---
# BMC_WEBHOOK_SECRET=
# BMC_MIN_SUPPORT_USD=3
# NEXT_PUBLIC_BMC_AMERICAS_URL=https://buymeacoffee.com/positivwarrior
# NEXT_PUBLIC_BMC_AFRICA_URL=https://buymeacoffee.com/positivwarrior

# --- Optional ---
# GOOGLE_GENAI_API_KEY=
